# ibl.ai configuration — copy to .env.local (gitignored) and set your values.
# The four URLs below mirror the code defaults in lib/iblai/config.ts (hosted
# iblai.app), so the app works without them — they are listed here as the
# knobs to change when self-hosting. NEXT_PUBLIC_MAIN_TENANT_KEY is required;
# IBLAI_API_KEY (a secret — never commit it) unlocks server-side platform
# API calls via config.apiKey(), and doubles as a standard OpenAI api key at
# https://asgi.data.<domain>/api/ai-mentor/orgs/<tenant>/v1 (chat completions
# + models) for the app's LLM features — no separate provider key needed.
# Distributed self-hosted mode: delete the NEXT_PUBLIC_API_BASE_URL line
# (and set your own NEXT_PUBLIC_PLATFORM_BASE_DOMAIN) so each service derives
# its own subdomain — editing only the domain keeps you on this single origin.
NEXT_PUBLIC_API_BASE_URL=https://api.iblai.app
NEXT_PUBLIC_AUTH_URL=https://login.iblai.app
NEXT_PUBLIC_BASE_WS_URL=wss://asgi.data.iblai.app
NEXT_PUBLIC_PLATFORM_BASE_DOMAIN=iblai.app
NEXT_PUBLIC_MAIN_TENANT_KEY=your-platform
IBLAI_API_KEY=your-token

# What the join step ("Join <name>"), the Stripe product and the browser tab
# call the app.
NEXT_PUBLIC_APP_NAME=memorare twin
NEXT_PUBLIC_SUPPORT_EMAIL=support@iblai.zendesk.com

# Paywall (server-only; see README "Access & payments"). Paying is the only way
# into the tenant. PAYWALL_APP_SLUG names this app on the platform: it tags the
# Stripe product (metadata.app, the platform's checkout rule) and keys the
# published plan in the tenant's public metadata (apps.<slug>), which the
# Account page's payments form writes. PAYWALL_PRICE_IDS is an optional
# comma-separated override of that plan.
PAYWALL_APP_SLUG=ibl-twin
PAYWALL_PRICE_IDS=

# The app's public origin for the Stripe return URLs. Empty means the origin
# each request arrives on (right on localhost and behind nginx).
IBLAI_APP_BASE_URL=

# Fallback platform credential while IBLAI_API_KEY is empty: a workspace
# admin's own DM session token (localStorage `dm_token` after sign-in). The
# platform accepts it for checkout, joining and the ledger, but it expires with
# that session. Prefer IBLAI_API_KEY: os.ibl.ai → Integrations → APIs → Add API.
IBLAI_ADMIN_TOKEN=
